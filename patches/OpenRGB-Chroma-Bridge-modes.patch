diff --git a/Controllers/DebugController/RGBController_Debug.cpp b/Controllers/DebugController/RGBController_Debug.cpp
index 9b1aa79..abba10d 100644
--- a/Controllers/DebugController/RGBController_Debug.cpp
+++ b/Controllers/DebugController/RGBController_Debug.cpp
@@ -64,6 +64,78 @@ RGBController_Debug::RGBController_Debug(bool custom, json settings)
 
     modes.push_back(Direct);
 
+    /*-----------------------------------------------------*\
+    | The Chroma Bridge debug device is a software effect   |
+    | control surface.  The bridge renders these modes on   |
+    | one shared clock and sends Direct frames to hardware. |
+    \*-----------------------------------------------------*/
+    if(!custom && JsonUtils::JsonGetString(debug_settings, "name") == "Chroma Bridge")
+    {
+        mode Static;
+        Static.name                       = "Static";
+        Static.value                      = 1;
+        Static.flags                      = MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_MODE_SPECIFIC_COLOR;
+        Static.brightness_min             = 0;
+        Static.brightness_max             = 100;
+        Static.brightness                 = 100;
+        Static.color_mode                 = MODE_COLORS_MODE_SPECIFIC;
+        Static.colors_min                 = 1;
+        Static.colors_max                 = 1;
+        Static.colors.push_back(ToRGBColor(255, 255, 255));
+        modes.push_back(Static);
+
+        mode Breathing;
+        Breathing.name                    = "Breathing";
+        Breathing.value                   = 2;
+        Breathing.flags                   = MODE_FLAG_HAS_SPEED | MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_MODE_SPECIFIC_COLOR;
+        Breathing.speed_min               = 0;
+        Breathing.speed_max               = 100;
+        Breathing.speed                   = 30;
+        Breathing.brightness_min          = 0;
+        Breathing.brightness_max          = 100;
+        Breathing.brightness              = 100;
+        Breathing.color_mode              = MODE_COLORS_MODE_SPECIFIC;
+        Breathing.colors_min              = 2;
+        Breathing.colors_max              = 2;
+        Breathing.colors.push_back(ToRGBColor(255, 255, 255));
+        Breathing.colors.push_back(ToRGBColor(255, 0, 0));
+        modes.push_back(Breathing);
+
+        mode Spectrum;
+        Spectrum.name                     = "Spectrum Cycle";
+        Spectrum.value                    = 3;
+        Spectrum.flags                    = MODE_FLAG_HAS_SPEED | MODE_FLAG_HAS_BRIGHTNESS;
+        Spectrum.speed_min                = 0;
+        Spectrum.speed_max                = 100;
+        Spectrum.speed                    = 50;
+        Spectrum.brightness_min           = 0;
+        Spectrum.brightness_max           = 100;
+        Spectrum.brightness               = 100;
+        Spectrum.color_mode               = MODE_COLORS_NONE;
+        modes.push_back(Spectrum);
+
+        mode Wave;
+        Wave.name                         = "Wave";
+        Wave.value                        = 4;
+        Wave.flags                        = MODE_FLAG_HAS_SPEED | MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_DIRECTION_LR;
+        Wave.speed_min                    = 0;
+        Wave.speed_max                    = 100;
+        Wave.speed                        = 50;
+        Wave.brightness_min               = 0;
+        Wave.brightness_max               = 100;
+        Wave.brightness                   = 100;
+        Wave.direction                    = MODE_DIRECTION_RIGHT;
+        Wave.color_mode                   = MODE_COLORS_NONE;
+        modes.push_back(Wave);
+
+        mode Off;
+        Off.name                          = "Off";
+        Off.value                         = 5;
+        Off.flags                         = 0;
+        Off.color_mode                    = MODE_COLORS_NONE;
+        modes.push_back(Off);
+    }
+
     SetupDevice();
     SetupZones();
 }
