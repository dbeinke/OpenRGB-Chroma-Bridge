<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenRGB-Chroma-Bridge</AssemblyName>
    <RootNamespace>OpenRgbChromaBridge</RootNamespace>
    <Version>1.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenRGB.NET">
      <HintPath>lib\OpenRGB.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="bridge-config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ChromaAppInfo.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="watchdog.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="install-virtual-controller.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="patches\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="G19Dashboard\**\*.cs" />
    <EmbeddedResource Remove="G19Dashboard\**\*" />
    <None Remove="G19Dashboard\**\*" />
  </ItemGroup>
</Project>
