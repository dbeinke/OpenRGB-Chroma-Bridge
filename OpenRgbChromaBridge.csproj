<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenRGB-Chroma-Bridge</AssemblyName>
    <RootNamespace>OpenRgbChromaBridge</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="bridge-config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ChromaAppInfo.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="watchdog.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="install-virtual-controller.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
